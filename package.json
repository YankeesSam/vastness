{
  "name": "vastness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The solar system and its spacecraft in the browser, positioned from NASA/JPL Horizons data",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YankeesSam/vastness.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "ephem": "node --experimental-strip-types --no-warnings tools/ephem/main.ts",
    "check-deps": "node scripts/check-deps.mjs",
    "check-size": "node scripts/check-size.mjs",
    "ephem:check": "node --experimental-strip-types --no-warnings tools/ephem/check.ts",
    "bench": "vitest bench --run",
    "ephem:check-ids": "node --experimental-strip-types --no-warnings tools/ephem/check-ids.ts",
    "gp": "node --experimental-strip-types --no-warnings tools/gp/gp.ts",
    "stars": "node --experimental-strip-types --no-warnings tools/stars/build.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
