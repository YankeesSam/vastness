{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(npm run e2e:*)",
      "Bash(npm run ephem:check:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx vitest bench:*)",
      "Bash(npx tsc:*)",
      "Bash(npx prettier --check:*)",
      "Bash(npx prettier --write:*)",
      "Bash(npx playwright test:*)",
      "Bash(node scripts/check-deps.mjs:*)",
      "Bash(node --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(bash scripts/check-env.sh)",
      "Bash(bash scripts/nightly.sh)",
      "Bash(bash scripts/nightly-build.sh:*)",
      "Bash(bash scripts/deploy-web.sh:*)",
      "Bash(bash scripts/check-pages.sh)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release view:*)",
      "Bash(bash .claude/skills/vastness/scripts/validate-agent.sh:*)",
      "Bash(bash .claude/skills/vastness-handoff/scripts/commit.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(sudo:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prettier-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
